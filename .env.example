# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Gmail (IMAP with an app password; see README) ---
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Gmail search applied to every IMAP query (pre-excludes noise before anything is downloaded)
IMAP_QUERY=-category:promotions -category:social -in:chats

# --- Google Calendar (optional; see README) ---
# Written by `jobtracker calendar use-service-account KEY_FILE`: the calendar's ID (your Gmail
# address for the main calendar) and base64 of the service account's key. Secret.
# GOOGLE_CALENDAR_ID=you@gmail.com
# GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Anthropic ---
# No API key: the app uses your `ant auth login` session (README, *Anthropic login*).
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low
# Effort for the "paste anything" assistant (longer, messier input)
LLM_PASTE_EFFORT=medium
LLM_BODY_CHARS=4000

# --- Auth ---
ALLOWED_EMAIL=you@gmail.com
# Local only. The app refuses to start with this set in prod or inside Lambda.
AUTH_DEV_BYPASS=true
# Prod only (Terraform sets them on the Lambda); local uses the bypass above.
# COGNITO_USER_POOL_ID=us-east-1_...
# COGNITO_CLIENT_ID=
# COGNITO_DOMAIN=https://<prefix>.auth.us-east-1.amazoncognito.com
# APP_URL=https://jobs.alexisherrera.dev

# --- Behaviour ---
TIMEZONE=America/Buenos_Aires
GHOST_DAYS=14
FOLLOWUP_DAYS=7

# --- Local database (docker compose publishes Postgres on localhost:5433) ---
# DATABASE_URL=postgresql://jobtracker:jobtracker@localhost:5433/jobtracker
